# Rust 构建产物
daemon/target/
target/

# C++ 探针桩构建产物
probe/build/

# L2 dex 工程构建产物
dex/build/

# CI 打包时注入模块的 dex 资产（不提交；git 中仅保留源码，资产由 build-dex job 产出）
module/probe/
module/system/etc/sundown/probe.dex
module/system/etc/sundown/bridge.dex

# L2b native 伴生库构建产物与 CI 注入资产（build-bridge job 产出）
bridge/build/
module/system/lib64/
module/hook/

# 打包产物
*.zip

# 系统杂项
.DS_Store
Thumbs.db

# 注意：module/system/bin/sundownd 的文本占位文件需要被 git 跟踪（保证脚本权限设置不失败），
# CI 打包时会在工作区覆盖为真实二进制，不提交该变更。