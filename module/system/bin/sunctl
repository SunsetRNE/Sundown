#!/system/bin/sh
# sunctl - Sundown 控制 CLI (L0)
# WebUI 的唯一后端入口；所有管理动作经此收敛，便于审计。
# 命令规范详见 docs/sunctl-spec.md

MODBASE="/data/adb/modules/sundown"
SUNDOWN_DIR="/data/adb/sundown"
DAEMON_PATH="$MODBASE/system/bin/sundownd"
INSTALLED_META="$SUNDOWN_DIR/update/installed.json"
READY_MARKER="$SUNDOWN_DIR/update/daemon.ready"
SOCK_PATH="$SUNDOWN_DIR/sundownd.sock"
LOG_DIR="$SUNDOWN_DIR/logs"
VERSION="0.4.11-l3"

# ---------- 工具函数 ----------

json_string() {
    sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$2" 2>/dev/null | head -n 1
}

# 从 stdin 的单行 JSON 提取字符串字段
json_str_in() {
    sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" | head -n 1
}

# 从 stdin 的单行 JSON 提取数字字段
json_int_in() {
    sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p" | head -n 1
}

# 经 daemon 控制 socket 查询（行协议：发一行命令，收一行 JSON）
# 用法: sock_query status  →  stdout 输出应答 JSON；失败返回非零
sock_query() {
    [ -S "$SOCK_PATH" ] || return 1
    command -v nc >/dev/null 2>&1 || return 1
    resp="$(printf '%s\n' "$1" | nc -U -w 2 "$SOCK_PATH" 2>/dev/null | head -n 1)"
    case "$resp" in
        \{*\}|\[*\]) printf '%s' "$resp"; return 0 ;;
        *)     return 1 ;;
    esac
}

daemon_pid() {
    pgrep -f "$DAEMON_PATH" 2>/dev/null | head -n 1
}

daemon_version() {
    v="$(json_string version_name "$INSTALLED_META")"
    [ -n "$v" ] && echo "$v" || echo "$VERSION"
}

# 探测 Zygisk 提供方：rezygisk / zygisknext / magisk-zygisk / none
zygisk_provider() {
    if [ -d /data/adb/modules/rezygisk ]; then
        echo "rezygisk"
    elif [ -d /data/adb/modules/zygisksu ] || [ -d /data/adb/modules/ZygiskNext ]; then
        echo "zygisknext"
    elif [ -f /data/adb/magisk/zygisk_enabled ] 2>/dev/null; then
        echo "magisk-zygisk"
    else
        echo "none"
    fi
}

# ---------- 命令实现 ----------

cmd_status() {
    json_out=0
    [ "$1" = "--json" ] && json_out=1

    provider="$(zygisk_provider)"
    boot_completed="$(getprop sys.boot_completed)"

    # 数据源 A（优先）：daemon 控制 socket —— 真实运行态
    sock_json="$(sock_query status)"
    if [ -n "$sock_json" ]; then
        # daemon 不掌握的字段由本地探测补全（--json 契约只增不改）
        sock_json="$(printf '%s' "$sock_json" | sed "s/\"zygisk_provider\":null/\"zygisk_provider\":\"$provider\"/")"
        sock_json="$(printf '%s' "$sock_json" | sed "s/}$/,\"boot_completed\":\"$boot_completed\"}/")"

        if [ "$json_out" = "1" ]; then
            printf '%s\n' "$sock_json"
        else
            ver="$(printf '%s' "$sock_json" | json_str_in version)"
            pid="$(printf '%s' "$sock_json" | json_int_in daemon_pid)"
            uptime="$(printf '%s' "$sock_json" | json_int_in uptime_s)"
            reloads="$(printf '%s' "$sock_json" | json_int_in config_reloads)"
            conns="$(printf '%s' "$sock_json" | json_int_in connections_served)"
            stub="$(printf '%s' "$sock_json" | json_int_in probe_stub_loaded)"
            phash="$(printf '%s' "$sock_json" | json_str_in probe_stub_build_hash)"
            echo "Sundown 状态（数据源: daemon socket）"
            echo "  模块版本:      $ver"
            echo "  守护进程:      ✅ 运行中 (PID: $pid, uptime: ${uptime}s)"
            echo "  配置热加载:    ${reloads} 次 | 控制连接: ${conns} 次"
            echo "  Zygisk 提供方: $provider"
            if [ "$stub" = "1" ]; then
                echo "  L1 探针桩:     ✅ 已注入 system_server (hash: $phash)"
            else
                echo "  L1 探针桩:     ⏸ 已打包入模块，待重启后激活"
            fi
            dver="$(printf '%s' "$sock_json" | json_str_in probe_dex_version)"
            dmatch="$(printf '%s' "$sock_json" | json_int_in probe_dex_hash_match)"
            if [ -n "$dver" ]; then
                case "$dmatch" in
                    1) echo "  L2 探针 dex:   ✅ 运行中 (build: $dver, 版本闭环匹配)" ;;
                    0) echo "  L2 探针 dex:   ⚠️ 运行中 (build: $dver, 与期望版本不符，可 sunctl reload-probe)" ;;
                    *) echo "  L2 探针 dex:   ✅ 运行中 (build: $dver)" ;;
                esac
            else
                if [ "$stub" = "1" ]; then
                    # 桩在线但 dex 未上报：桩的 dex 加载桥是一次性的（失败不重试），
                    # 此状态=冷启动加载失败，需软重启 zygote 重试或查 logcat 取证
                    echo "  L2 探针 dex:   ⚠️ 桩已在线但 dex 未接管（软重启运行时重试；查 logcat SundownProbe/SundownDex）"
                else
                    echo "  L2 探针 dex:   ⏸ 待重启后随桩注入加载（冷启动/断线自愈）"
                fi
            fi
            # L2b：native 伴生库（LSPlant 机制）+ 焦点/唤醒观测面
            bhash="$(printf '%s' "$sock_json" | json_str_in probe_hook_bridge_hash)"
            bmatch="$(printf '%s' "$sock_json" | json_int_in probe_hook_bridge_hash_match)"
            focus="$(printf '%s' "$sock_json" | json_str_in focus_pkg)"
            fchanges="$(printf '%s' "$sock_json" | json_int_in focus_changes)"
            wevents="$(printf '%s' "$sock_json" | json_int_in wakeup_events)"
            if [ -n "$bhash" ]; then
                case "$bmatch" in
                    1) echo "  L2b hook 桥:   ✅ 运行中 (build: $bhash, 版本闭环匹配)" ;;
                    0) echo "  L2b hook 桥:   ⚠️ 运行中 (build: $bhash, 与期望不符，刷入一致版本后软重启)" ;;
                    *) echo "  L2b hook 桥:   ✅ 运行中 (build: $bhash)" ;;
                esac
                echo "  焦点/唤醒:     前台=${focus:-未知} | 焦点切换 ${fchanges:-0} 次 | 唤醒事件 ${wevents:-0} 条"
            else
                echo "  L2b hook 桥:   ⏸ 未上线（bridge.dex/伴生库未交付或引导中；查 logcat SundownDex/SundownHook）"
            fi
        fi
        return 0
    fi

    # 数据源 B（降级）：文件系统探测 —— daemon 未运行/未就绪时的视图
    pid="$(daemon_pid)"
    running=0; [ -n "$pid" ] && running=1
    ready=0; [ -f "$READY_MARKER" ] && ready=1

    if [ "$json_out" = "1" ]; then
        cat <<EOF
{
  "module": "sundown",
  "version": "$(daemon_version)",
  "daemon_running": $running,
  "daemon_pid": ${pid:-null},
  "daemon_ready": $ready,
  "zygisk_provider": "$provider",
  "probe_stub_loaded": 0,
  "probe_dex_version": null,
  "probe_dex_hash_match": null,
  "boot_completed": "$boot_completed"
}
EOF
    else
        echo "Sundown 状态（数据源: 文件探测，daemon 未连接）"
        echo "  模块版本:      $(daemon_version)"
        if [ "$running" = "1" ]; then
            echo "  守护进程:      ✅ 运行中 (PID: $pid, ready=$ready)"
        else
            echo "  守护进程:      ❌ 未运行"
        fi
        echo "  Zygisk 提供方: $provider"
        echo "  L1 探针桩:     ⏸ 已打包入模块，待重启后激活"
        echo "  L2 探针 dex:   ⏸ daemon 未连接，运行态未知（冷启动兜底走 magic-mount 路径）"
    fi
    [ "$running" = "1" ] && return 0 || return 1
}

cmd_restart_daemon() {
    echo "正在重启 sundownd..."
    pgrep -f "$DAEMON_PATH" | while read -r p; do kill "$p" 2>/dev/null; done
    sleep 1
    if [ ! -x "$DAEMON_PATH" ]; then
        echo "❌ $DAEMON_PATH 不存在或不可执行（L0 骨架尚未内置二进制）" >&2
        return 1
    fi
    nohup "$DAEMON_PATH" >/dev/null 2>&1 &
    sleep 3
    pid="$(daemon_pid)"
    if [ -n "$pid" ]; then
        echo "✅ sundownd 已启动 (PID: $pid)"
        return 0
    fi
    echo "❌ sundownd 启动失败，请检查 $LOG_DIR" >&2
    return 1
}

cmd_restart_runtime() {
    # 软重启：重启 Android 运行时（zygote），不丢应用数据
    # 用于 L1 探针桩 .so 更新后的热重启
    if [ "$1" != "--yes" ]; then
        echo "⚠️  软重启将结束所有应用进程（状态由系统保存，通常不丢数据）。"
        echo "    屏幕会黑屏几秒后回到锁屏界面。"
        echo "    确认执行请运行: sunctl restart-runtime --yes" >&2
        return 2
    fi
    echo "正在重启 Android 运行时..."
    setprop ctl.restart zygote
    setprop ctl.restart zygote_secondary 2>/dev/null
    return 0
}

cmd_reload_probe() {
    # L2 热更新：经 daemon 管理面推送 probe.dex，运行中的 dex 层 ClassLoader 热切换
    resp="$(sock_query "push-dex")"
    if [ -z "$resp" ]; then
        echo "❌ daemon 未连接（socket 不可用），无法推送" >&2
        return 1
    fi
    ok="$(printf '%s' "$resp" | json_int_in ok)"
    if [ "$ok" != "1" ]; then
        err="$(printf '%s' "$resp" | json_str_in error)"
        echo "❌ 推送失败: ${err:-未知错误}" >&2
        return 1
    fi
    notified="$(printf '%s' "$resp" | json_int_in notified)"
    dex_path="$(printf '%s' "$resp" | json_str_in dex_path)"
    size="$(printf '%s' "$resp" | json_int_in size)"
    if [ "${notified:-0}" -ge 1 ]; then
        echo "✅ 已推送 probe.dex（${size:-?} 字节）并通知 ${notified} 个在线探针热切换"
        echo "   字节源: $dex_path"
        echo "   提示: 热切换结果以 logcat（tag SundownDex）与 sunctl status 的 probe_dex_version 为准"
    else
        echo "ℹ️  当前无在线探针 dex；新 dex 将在探针下次上线时自动加载（冷启动/自愈）"
        echo "   字节源: $dex_path（${size:-?} 字节）"
    fi
    return 0
}

cmd_apply_update() {
    # staged 更新：将已校验的 sundownd.new 放入 pending，等待重启激活
    echo "❌ apply-update 由更新中心在后续阶段提供（staged 通道已就绪）" >&2
    return 3
}

cmd_env_check() {
    echo "Sundown 环境自检"
    ok=0

    if [ -n "$KSU" ] || command -v ksud >/dev/null 2>&1; then
        echo "  ✅ KernelSU 环境"
    else
        echo "  ℹ️  非 KSU 环境（Magisk?）"
    fi

    provider="$(zygisk_provider)"
    case "$provider" in
        none) echo "  ⚠️  未检测到 Zygisk 提供方（ReZygisk/ZygiskNext），L1 探针不可用" ;;
        *)    echo "  ✅ Zygisk 提供方: $provider" ;;
    esac

    if [ -x "$DAEMON_PATH" ]; then
        echo "  ✅ sundownd 二进制存在"
    else
        echo "  ❌ sundownd 二进制缺失（L0 骨架阶段正常）"
        ok=1
    fi

    [ -d "$SUNDOWN_DIR" ] && echo "  ✅ 数据目录 $SUNDOWN_DIR" || { echo "  ❌ 数据目录缺失"; ok=1; }
    [ -f "$SUNDOWN_DIR/data/.migrated_from_cerberus" ] && echo "  ℹ️  已完成 Cerberus 旧资产迁移"

    return $ok
}

cmd_logs() {
    # logs [行数]           -> boot_watchdog.log 末尾（兼容旧调用）
    # logs --engine [行数]  -> sundownd.log 末尾（引擎事件时间轴，WebUI 日志页使用）
    src="$LOG_DIR/boot_watchdog.log"
    lines="${1:-50}"
    if [ "$1" = "--engine" ]; then
        src="$LOG_DIR/sundownd.log"
        lines="${2:-100}"
    fi
    [ -f "$src" ] && tail -n "$lines" "$src" || echo "暂无日志"
}

cmd_policy() {
    # L3 策略管理（WebUI 配置页后端；经 daemon 管理面 socket，收敛单一入口）
    #   policy status -> 策略状态 JSON（enabled/grace/cooldown/白名单/force/冻结表/计数）
    #   policy reload -> 强制从磁盘重载（失败保留旧表）
    sub="${1:-status}"
    case "$sub" in
        status|reload)
            resp="$(sock_query "policy $sub")"
            if [ -z "$resp" ]; then
                echo "❌ daemon 未连接（socket 不可用），无法执行 policy $sub" >&2
                return 1
            fi
            printf '%s\n' "$resp"
            return 0
            ;;
        *)
            echo "用法: sunctl policy status|reload" >&2
            return 2
            ;;
    esac
}

cmd_events() {
    # L3.1 结构化事件时间线（JSON 数组，最旧→最新；WebUI 日志页数据源升级的前置）
    #   events [行数=50] -> 最近 N 条（缺省 50；0 = 全部）
    lines="${1:-50}"
    case "$lines" in
        ''|*[!0-9]*) echo "用法: sunctl events [行数]" >&2; return 2 ;;
    esac
    resp="$(sock_query "events $lines")"
    if [ -z "$resp" ]; then
        echo "❌ daemon 未连接（socket 不可用），无法读取事件缓冲" >&2
        return 1
    fi
    printf '%s\n' "$resp"
    return 0
}

cmd_version() {
    echo "Sundown $VERSION (by SunsetREN)"
    echo "  daemon: $(daemon_version)"
}

usage() {
    cat >&2 <<EOF
用法: sunctl <命令> [参数]

  status [--json]        查看模块与守护进程状态
  env-check              环境自检（KSU / Zygisk 提供方 / 文件完整性）
  restart-daemon         重启 sundownd 守护进程
  restart-runtime --yes  软重启 Android 运行时（zygote，不丢数据）
  reload-probe           [L2] 热更新探针 dex
  policy status          [L3] 查询冻结策略状态（JSON）
  policy reload          [L3] 强制从磁盘重载策略
  events [行数]          [L3.1] 结构化事件时间线（JSON；焦点/唤醒/冻结/豁免/握手）
  apply-update           [后续] 激活 staged 守护进程更新
  logs [行数]            查看启动看门狗日志
  logs --engine [行数]   查看引擎事件日志（焦点/唤醒/冻结时间轴）
  version                版本信息
EOF
    return 2
}

# ---------- 入口 ----------

case "$1" in
    status)          shift; cmd_status "$@" ;;
    env-check)       cmd_env_check ;;
    restart-daemon)  cmd_restart_daemon ;;
    restart-runtime) shift; cmd_restart_runtime "$@" ;;
    reload-probe)    cmd_reload_probe ;;
    policy)          shift; cmd_policy "$@" ;;
    events)          shift; cmd_events "$@" ;;
    apply-update)    cmd_apply_update ;;
    logs)            shift; cmd_logs "$@" ;;
    version|--version|-v) cmd_version ;;
    *)               usage ;;
esac