#!/system/bin/sh
# sunctl - Sundown 控制 CLI (L0)
# WebUI 的唯一后端入口；所有管理动作经此收敛，便于审计。
# 命令规范详见 docs/sunctl-spec.md

MODBASE="/data/adb/modules/sundown"
SUNDOWN_DIR="/data/adb/sundown"
DAEMON_PATH="$MODBASE/system/bin/sundownd"
INSTALLED_META="$SUNDOWN_DIR/update/installed.json"
READY_MARKER="$SUNDOWN_DIR/update/daemon.ready"
SOCK_PATH="$SUNDOWN_DIR/sundownd.sock"
LOG_DIR="$SUNDOWN_DIR/logs"
VERSION="0.4.21-l3"

# ---------- 工具函数 ----------

json_string() {
    sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$2" 2>/dev/null | head -n 1
}

# 从 stdin 的单行 JSON 提取字符串字段
json_str_in() {
    sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" | head -n 1
}

# 从 stdin 的单行 JSON 提取数字字段
json_int_in() {
    sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p" | head -n 1
}

# 经 daemon 控制 socket 查询（行协议：发一行命令，收一行 JSON）
# 用法: sock_query status  →  stdout 输出应答 JSON；失败返回非零
sock_query() {
    [ -S "$SOCK_PATH" ] || return 1
    command -v nc >/dev/null 2>&1 || return 1
    resp="$(printf '%s\n' "$1" | nc -U -w 2 "$SOCK_PATH" 2>/dev/null | head -n 1)"
    case "$resp" in
        \{*\}|\[*\]) printf '%s' "$resp"; return 0 ;;
        *)     return 1 ;;
    esac
}

daemon_pid() {
    pgrep -f "$DAEMON_PATH" 2>/dev/null | head -n 1
}

daemon_version() {
    v="$(json_string version_name "$INSTALLED_META")"
    [ -n "$v" ] && echo "$v" || echo "$VERSION"
}

# 探测 Zygisk 提供方：rezygisk / zygisknext / magisk-zygisk / none
zygisk_provider() {
    if [ -d /data/adb/modules/rezygisk ]; then
        echo "rezygisk"
    elif [ -d /data/adb/modules/zygisksu ] || [ -d /data/adb/modules/ZygiskNext ]; then
        echo "zygisknext"
    elif [ -f /data/adb/magisk/zygisk_enabled ] 2>/dev/null; then
        echo "magisk-zygisk"
    else
        echo "none"
    fi
}

# ---------- 命令实现 ----------

cmd_status() {
    json_out=0
    [ "$1" = "--json" ] && json_out=1

    provider="$(zygisk_provider)"
    boot_completed="$(getprop sys.boot_completed)"

    # 数据源 A（优先）：daemon 控制 socket —— 真实运行态
    sock_json="$(sock_query status)"
    if [ -n "$sock_json" ]; then
        # daemon 不掌握的字段由本地探测补全（--json 契约只增不改）
        sock_json="$(printf '%s' "$sock_json" | sed "s/\"zygisk_provider\":null/\"zygisk_provider\":\"$provider\"/")"
        sock_json="$(printf '%s' "$sock_json" | sed "s/}$/,\"boot_completed\":\"$boot_completed\"}/")"

        if [ "$json_out" = "1" ]; then
            printf '%s\n' "$sock_json"
        else
            ver="$(printf '%s' "$sock_json" | json_str_in version)"
            pid="$(printf '%s' "$sock_json" | json_int_in daemon_pid)"
            uptime="$(printf '%s' "$sock_json" | json_int_in uptime_s)"
            reloads="$(printf '%s' "$sock_json" | json_int_in config_reloads)"
            conns="$(printf '%s' "$sock_json" | json_int_in connections_served)"
            stub="$(printf '%s' "$sock_json" | json_int_in probe_stub_loaded)"
            phash="$(printf '%s' "$sock_json" | json_str_in probe_stub_build_hash)"
            echo "Sundown 状态（数据源: daemon socket）"
            echo "  模块版本:      $ver"
            echo "  守护进程:      ✅ 运行中 (PID: $pid, uptime: ${uptime}s)"
            echo "  配置热加载:    ${reloads} 次 | 控制连接: ${conns} 次"
            echo "  Zygisk 提供方: $provider"
            if [ "$stub" = "1" ]; then
                echo "  L1 探针桩:     ✅ 已注入 system_server (hash: $phash)"
            else
                echo "  L1 探针桩:     ⏸ 已打包入模块，待重启后激活"
            fi
            dver="$(printf '%s' "$sock_json" | json_str_in probe_dex_version)"
            dmatch="$(printf '%s' "$sock_json" | json_int_in probe_dex_hash_match)"
            if [ -n "$dver" ]; then
                case "$dmatch" in
                    1) echo "  L2 探针 dex:   ✅ 运行中 (build: $dver, 版本闭环匹配)" ;;
                    0) echo "  L2 探针 dex:   ⚠️ 运行中 (build: $dver, 与期望版本不符，可 sunctl reload-probe)" ;;
                    *) echo "  L2 探针 dex:   ✅ 运行中 (build: $dver)" ;;
                esac
            else
                if [ "$stub" = "1" ]; then
                    # 桩在线但 dex 未上报：桩的 dex 加载桥是一次性的（失败不重试），
                    # 此状态=冷启动加载失败，需软重启 zygote 重试或查 logcat 取证
                    echo "  L2 探针 dex:   ⚠️ 桩已在线但 dex 未接管（软重启运行时重试；查 logcat SundownProbe/SundownDex）"
                else
                    echo "  L2 探针 dex:   ⏸ 待重启后随桩注入加载（冷启动/断线自愈）"
                fi
            fi
            # L2b：native 伴生库（LSPlant 机制）+ 焦点/唤醒观测面
            bhash="$(printf '%s' "$sock_json" | json_str_in probe_hook_bridge_hash)"
            bmatch="$(printf '%s' "$sock_json" | json_int_in probe_hook_bridge_hash_match)"
            focus="$(printf '%s' "$sock_json" | json_str_in focus_pkg)"
            fchanges="$(printf '%s' "$sock_json" | json_int_in focus_changes)"
            wevents="$(printf '%s' "$sock_json" | json_int_in wakeup_events)"
            if [ -n "$bhash" ]; then
                case "$bmatch" in
                    1) echo "  L2b hook 桥:   ✅ 运行中 (build: $bhash, 版本闭环匹配)" ;;
                    0) echo "  L2b hook 桥:   ⚠️ 运行中 (build: $bhash, 与期望不符，刷入一致版本后软重启)" ;;
                    *) echo "  L2b hook 桥:   ✅ 运行中 (build: $bhash)" ;;
                esac
                echo "  焦点/唤醒:     前台=${focus:-未知} | 焦点切换 ${fchanges:-0} 次 | 唤醒事件 ${wevents:-0} 条"
            else
                echo "  L2b hook 桥:   ⏸ 未上线（bridge.dex/伴生库未交付或引导中；查 logcat SundownDex/SundownHook）"
            fi
        fi
        return 0
    fi

    # 数据源 B（降级）：文件系统探测 —— daemon 未运行/未就绪时的视图
    pid="$(daemon_pid)"
    running=0; [ -n "$pid" ] && running=1
    ready=0; [ -f "$READY_MARKER" ] && ready=1

    if [ "$json_out" = "1" ]; then
        cat <<EOF
{
  "module": "sundown",
  "version": "$(daemon_version)",
  "daemon_running": $running,
  "daemon_pid": ${pid:-null},
  "daemon_ready": $ready,
  "zygisk_provider": "$provider",
  "probe_stub_loaded": 0,
  "probe_dex_version": null,
  "probe_dex_hash_match": null,
  "boot_completed": "$boot_completed"
}
EOF
    else
        echo "Sundown 状态（数据源: 文件探测，daemon 未连接）"
        echo "  模块版本:      $(daemon_version)"
        if [ "$running" = "1" ]; then
            echo "  守护进程:      ✅ 运行中 (PID: $pid, ready=$ready)"
        else
            echo "  守护进程:      ❌ 未运行"
        fi
        echo "  Zygisk 提供方: $provider"
        echo "  L1 探针桩:     ⏸ 已打包入模块，待重启后激活"
        echo "  L2 探针 dex:   ⏸ daemon 未连接，运行态未知（冷启动兜底走 magic-mount 路径）"
    fi
    [ "$running" = "1" ] && return 0 || return 1
}

cmd_restart_daemon() {
    echo "正在重启 sundownd..."
    pgrep -f "$DAEMON_PATH" | while read -r p; do kill "$p" 2>/dev/null; done
    sleep 1
    if [ ! -x "$DAEMON_PATH" ]; then
        echo "❌ $DAEMON_PATH 不存在或不可执行（L0 骨架尚未内置二进制）" >&2
        return 1
    fi
    nohup "$DAEMON_PATH" >/dev/null 2>&1 &
    sleep 3
    pid="$(daemon_pid)"
    if [ -n "$pid" ]; then
        echo "✅ sundownd 已启动 (PID: $pid)"
        return 0
    fi
    echo "❌ sundownd 启动失败，请检查 $LOG_DIR" >&2
    return 1
}

cmd_restart_runtime() {
    # 软重启：重启 Android 运行时（zygote），不丢应用数据
    # 用于 L1 探针桩 .so 更新后的热重启
    if [ "$1" != "--yes" ]; then
        echo "⚠️  软重启将结束所有应用进程（状态由系统保存，通常不丢数据）。"
        echo "    屏幕会黑屏几秒后回到锁屏界面。"
        echo "    确认执行请运行: sunctl restart-runtime --yes" >&2
        return 2
    fi
    echo "正在重启 Android 运行时..."
    setprop ctl.restart zygote
    setprop ctl.restart zygote_secondary 2>/dev/null
    return 0
}

cmd_reload_probe() {
    # L2 热更新：经 daemon 管理面推送 probe.dex，运行中的 dex 层 ClassLoader 热切换
    resp="$(sock_query "push-dex")"
    if [ -z "$resp" ]; then
        echo "❌ daemon 未连接（socket 不可用），无法推送" >&2
        return 1
    fi
    ok="$(printf '%s' "$resp" | json_int_in ok)"
    if [ "$ok" != "1" ]; then
        err="$(printf '%s' "$resp" | json_str_in error)"
        echo "❌ 推送失败: ${err:-未知错误}" >&2
        return 1
    fi
    notified="$(printf '%s' "$resp" | json_int_in notified)"
    dex_path="$(printf '%s' "$resp" | json_str_in dex_path)"
    size="$(printf '%s' "$resp" | json_int_in size)"
    if [ "${notified:-0}" -ge 1 ]; then
        echo "✅ 已推送 probe.dex（${size:-?} 字节）并通知 ${notified} 个在线探针热切换"
        echo "   字节源: $dex_path"
        echo "   提示: 热切换结果以 logcat（tag SundownDex）与 sunctl status 的 probe_dex_version 为准"
    else
        echo "ℹ️  当前无在线探针 dex；新 dex 将在探针下次上线时自动加载（冷启动/自愈）"
        echo "   字节源: $dex_path（${size:-?} 字节）"
    fi
    return 0
}

# ---------- staged 更新（v0.4.20-l3 实装，对齐 service.sh pending 格式） ----------
# pending 四件套：sundownd.new / installed.json.new / pending.sha256 / pending.json(staged_boot_id)
# 激活路径：A) 重启后 service.sh apply_pending_update（boot_id 变化才放行）
#          B) sunctl apply-update --activate 立即激活（用户显式确认，同 boot 允许）
NIGHTLY_API="https://api.github.com/repos/SunsetRNE/Sundown/releases/tags/nightly"
NIGHTLY_DL="https://github.com/SunsetRNE/Sundown/releases/download/nightly"
DL_DIR="$SUNDOWN_DIR/update/download"

# 下载模块 zip：<URL> 或缺省（GitHub API 查 nightly asset）
fetch_update_zip() {
    local src="$1" out="$DL_DIR/sundown.zip"
    mkdir -p "$DL_DIR"
    if [ -n "$src" ] && [ -f "$src" ]; then
        cp -p "$src" "$out" && echo "$out" && return 0
    fi
    local url="$src"
    if [ -z "$url" ]; then
        # 无参：GitHub API 查 nightly release 的 sundown-*.zip asset URL
        local api_json
        if command -v curl >/dev/null 2>&1; then
            api_json="$(curl -s --max-time 20 "$NIGHTLY_API" 2>/dev/null)"
        elif command -v wget >/dev/null 2>&1; then
            api_json="$(wget -qO- --timeout=20 "$NIGHTLY_API" 2>/dev/null)"
        else
            echo "❌ 无 curl/wget，无法查询 nightly 资源（可改传本地 zip 路径）" >&2
            return 1
        fi
        url="$(printf '%s' "$api_json" | sed -n 's/.*"browser_download_url"[[:space:]]*:[[:space:]]*"\([^"]*sundown-[^"]*\.zip\)".*//p' | head -n 1)"
        [ -z "$url" ] && { echo "❌ 未找到 nightly 模块包（Release 为空或 API 失败）" >&2; return 1; }
    fi
    echo "ℹ️  下载: $url"
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL --max-time 300 -o "$out" "$url" || { echo "❌ 下载失败" >&2; return 1; }
    elif command -v wget >/dev/null 2>&1; then
        wget -q -T 300 -O "$out" "$url" || { echo "❌ 下载失败" >&2; return 1; }
    else
        echo "❌ 无 curl/wget，无法下载（可改传本地 zip 路径）" >&2
        return 1
    fi
    [ -s "$out" ] || { echo "❌ 下载文件为空" >&2; return 1; }
    echo "$out"
}

# 提取 sundownd + 生成 pending 四件套；输出新版本号到 stdout（供调用方回显）
stage_update() {
    local zip="$1" src_label="$2"
    local tmp="$DL_DIR/extract"
    rm -rf "$tmp"; mkdir -p "$tmp"
    if ! command -v unzip >/dev/null 2>&1; then
        echo "❌ 无 unzip（toybox 应内置）" >&2; return 1
    fi
    unzip -o -q "$zip" -d "$tmp" system/bin/sundownd 2>/dev/null
    if [ ! -f "$tmp/system/bin/sundownd" ]; then
        echo "❌ zip 内缺少 system/bin/sundownd（不是 Sundown 模块包？）" >&2
        return 1
    fi
    local new_bin="$PENDING_DIR/sundownd.new"
    cp -p "$tmp/system/bin/sundownd" "$new_bin"
    chmod 0755 "$new_bin"
    # 运行新 daemon --version 解析版本（与 daemon 内部 release_no 同源）
    local ver_line new_ver new_rel
    ver_line="$( "$new_bin" --version 2>/dev/null | head -n 1 )"
    new_ver="$(printf '%s' "$ver_line" | sed -n 's/.*sundownd[[:space:]]*\([^ ]*\)[[:space:]]*(release_no[[:space:]]*\([0-9][0-9]*\).*//p')"
    new_rel="$(printf '%s' "$ver_line" | sed -n 's/.*(release_no[[:space:]]*\([0-9][0-9]*\).*//p')"
    if [ -z "$new_ver" ] || [ -z "$new_rel" ]; then
        echo "❌ 无法解析新 daemon 版本（--version 输出异常）" >&2
        return 1
    fi
    # 防降级：release_no 只增（同号允许重装覆盖）
    local cur_rel="$(json_number release_no "$INSTALLED_META")"
    [ -z "$cur_rel" ] && cur_rel=0
    if [ "$new_rel" -lt "$cur_rel" ] 2>/dev/null; then
        echo "❌ 拒绝降级：新包 release_no=$new_rel < 当前 $cur_rel" >&2
        return 1
    fi
    # 四件套写入
    printf '{"version_name":"%s","release_no":%s}
' "$new_ver" "$new_rel" > "$PENDING_DIR/installed.json.new"
    sha256sum "$new_bin" 2>/dev/null | awk '{print $1}' > "$PENDING_DIR/pending.sha256"
    local boot_id="$(tr -d '[:space:]' < /proc/sys/kernel/random/boot_id 2>/dev/null)"
    printf '{"staged_boot_id":"%s","source":"%s","staged_at":"%s"}
'         "$boot_id" "$src_label" "$(date 2>/dev/null)" > "$PENDING_DIR/pending.json"
    if [ ! -s "$PENDING_DIR/pending.sha256" ]; then
        echo "❌ sha256 生成失败" >&2; return 1
    fi
    echo "$new_ver|$new_rel"
}

# 立即激活（--activate）：备份 → 替换 → 重启 daemon → readiness → 失败回滚
activate_pending_update() {
    local pending_bin="$PENDING_DIR/sundownd.new"
    local pending_meta="$PENDING_DIR/installed.json.new"
    local pending_sha="$PENDING_DIR/pending.sha256"
    [ -f "$pending_bin" ] && [ -f "$pending_meta" ] && [ -f "$pending_sha" ] || {
        echo "❌ 无 pending 更新（先执行 sunctl apply-update）" >&2; return 1
    }
    # SHA256 校验（与 service.sh 同规）
    local expected_sha="$(tr -d '[:space:]' < "$pending_sha")"
    local actual_sha="$(sha256sum "$pending_bin" 2>/dev/null | awk '{print $1}')"
    case "$expected_sha" in *[!0-9a-f]*|"") echo "❌ pending.sha256 无效" >&2; return 1 ;; esac
    if [ "${#expected_sha}" -ne 64 ] || [ "$actual_sha" != "$expected_sha" ]; then
        echo "❌ SHA256 不匹配，拒绝激活" >&2; return 1
    fi
    local new_rel="$(json_number release_no "$pending_meta")"
    [ -z "$new_rel" ] && { echo "❌ installed.json.new 缺少 release_no" >&2; return 1; }
    # 备份
    rm -f "$BACKUP_DIR/sundownd.previous" "$BACKUP_DIR/installed.json.previous"
    cp -p "$DAEMON_PATH" "$BACKUP_DIR/sundownd.previous" || { echo "❌ 备份失败" >&2; return 1; }
    [ -f "$INSTALLED_META" ] && cp -p "$INSTALLED_META" "$BACKUP_DIR/installed.json.previous"
    # 替换 + 重启
    rm -f "$READY_MARKER"
    cp -p "$pending_bin" "$DAEMON_PATH" || { echo "❌ 激活失败（已备份）" >&2; return 1; }
    chmod 0755 "$DAEMON_PATH"
    cp -p "$pending_meta" "$INSTALLED_META" || { echo "❌ 元数据激活失败" >&2; return 1; }
    pgrep -f "$DAEMON_PATH" | while read -r old_pid; do kill "$old_pid" 2>/dev/null; done
    sleep 1
    nohup "$DAEMON_PATH" >/dev/null 2>&1 &
    # readiness：20s 等 ready 标记 + 10s 稳定性 + release_no 比对
    local rw=0
    while [ "$rw" -lt 20 ] && [ ! -f "$READY_MARKER" ]; do sleep 1; rw=$((rw + 1)); done
    local sw=0
    while [ "$sw" -lt 10 ] && pgrep -f "$DAEMON_PATH" >/dev/null; do sleep 1; sw=$((sw + 1)); done
    local ready_rel="$(json_number release_no "$READY_MARKER")"
    if [ ! -f "$READY_MARKER" ] || ! pgrep -f "$DAEMON_PATH" >/dev/null || [ "$ready_rel" != "$new_rel" ]; then
        echo "❌ 新 daemon readiness 校验失败，回滚…"
        pgrep -f "$DAEMON_PATH" | while read -r fpid; do kill "$fpid" 2>/dev/null; done
        sleep 1
        cp -p "$BACKUP_DIR/sundownd.previous" "$DAEMON_PATH"
        chmod 0755 "$DAEMON_PATH"
        [ -f "$BACKUP_DIR/installed.json.previous" ] && cp -p "$BACKUP_DIR/installed.json.previous" "$INSTALLED_META"
        rm -f "$READY_MARKER"
        nohup "$DAEMON_PATH" >/dev/null 2>&1 &
        echo "❌ 已回滚到原版本并重启" >&2
        return 1
    fi
    # 成功：清理 pending + 备份
    rm -f "$PENDING_DIR/sundownd.new" "$PENDING_DIR/installed.json.new" "$PENDING_DIR/pending.sha256" "$PENDING_DIR/pending.json"
    rm -f "$BACKUP_DIR/sundownd.previous" "$BACKUP_DIR/installed.json.previous"
    echo "✅ 已激活新 daemon（release_no $new_rel）并重启"
    return 0
}

cmd_apply_update() {
    # 用法: sunctl apply-update [<zip路径|URL>] [--activate]
    local activate=0 src=""
    for a in "$@"; do
        case "$a" in
            --activate) activate=1 ;;
            *) src="$a" ;;
        esac
    done
    if [ "$activate" = "1" ]; then
        if [ -n "$src" ]; then
            # --activate 且带源：先下载暂存再立即激活
            local zip="$(fetch_update_zip "$src")" || return 1
            stage_update "$zip" "$src" >/dev/null || return 1
        fi
        activate_pending_update
        return $?
    fi
    local zip="$(fetch_update_zip "$src")" || return 1
    local label="${src:-nightly}"
    local staged
    staged="$(stage_update "$zip" "$label")" || return 1
    local new_ver="${staged%%|*}" new_rel="${staged##*|}"
    local cur_rel="$(json_number release_no "$INSTALLED_META")"
    if [ -n "$cur_rel" ] && [ "$new_rel" = "$cur_rel" ]; then
        echo "ℹ️  已是最新（release_no $cur_rel），暂存覆盖完成（可 --activate 重装）"
    else
        echo "✅ 已暂存 $new_ver（release_no $new_rel → 当前 $cur_rel）"
    fi
    echo "   重启设备后 service.sh 自动激活（校验 SHA256 + readiness，失败自动回滚）"
    echo "   或立即激活: sunctl apply-update --activate"
    return 0
}

cmd_env_check() {
    echo "Sundown 环境自检"
    ok=0

    if [ -n "$KSU" ] || command -v ksud >/dev/null 2>&1; then
        echo "  ✅ KernelSU 环境"
    else
        echo "  ℹ️  非 KSU 环境（Magisk?）"
    fi

    provider="$(zygisk_provider)"
    case "$provider" in
        none) echo "  ⚠️  未检测到 Zygisk 提供方（ReZygisk/ZygiskNext），L1 探针不可用" ;;
        *)    echo "  ✅ Zygisk 提供方: $provider" ;;
    esac

    if [ -x "$DAEMON_PATH" ]; then
        echo "  ✅ sundownd 二进制存在"
    else
        echo "  ❌ sundownd 二进制缺失（L0 骨架阶段正常）"
        ok=1
    fi

    [ -d "$SUNDOWN_DIR" ] && echo "  ✅ 数据目录 $SUNDOWN_DIR" || { echo "  ❌ 数据目录缺失"; ok=1; }
    [ -f "$SUNDOWN_DIR/data/.migrated_from_cerberus" ] && echo "  ℹ️  已完成 Cerberus 旧资产迁移"

    return $ok
}

cmd_logs() {
    # logs [行数]           -> boot_watchdog.log 末尾（兼容旧调用）
    # logs --engine [行数]  -> sundownd.log 末尾（引擎事件时间轴，WebUI 日志页使用）
    src="$LOG_DIR/boot_watchdog.log"
    lines="${1:-50}"
    if [ "$1" = "--engine" ]; then
        src="$LOG_DIR/sundownd.log"
        lines="${2:-100}"
    fi
    [ -f "$src" ] && tail -n "$lines" "$src" || echo "暂无日志"
}

cmd_policy() {
    # L3 策略管理（WebUI 配置页后端；经 daemon 管理面 socket，收敛单一入口）
    #   policy status -> 策略状态 JSON（enabled/grace/cooldown/白名单/force/冻结表/计数）
    #   policy reload -> 强制从磁盘重载（失败保留旧表）
    #   policy preset list        -> 情景预设列表 + 当前生效
    #   policy preset apply <n>   -> 应用预设（内存覆盖 [general]，不动磁盘 policy.toml）
    #   policy preset clear       -> 清除预设（回落磁盘 policy.toml 参数）
    sub="${1:-status}"
    case "$sub" in
        status|reload)
            resp="$(sock_query "policy $sub")"
            if [ -z "$resp" ]; then
                echo "❌ daemon 未连接（socket 不可用），无法执行 policy $sub" >&2
                return 1
            fi
            printf '%s\n' "$resp"
            return 0
            ;;
        preset)
            shift
            psub="${1:-list}"
            case "$psub" in
                list|clear)
                    resp="$(sock_query "policy preset $psub")"
                    ;;
                apply)
                    [ -n "$2" ] || { echo "用法: sunctl policy preset apply <预设名>" >&2; return 2; }
                    resp="$(sock_query "policy preset apply $2")"
                    ;;
                *)
                    echo "用法: sunctl policy preset list|apply <name>|clear" >&2
                    return 2
                    ;;
            esac
            if [ -z "$resp" ]; then
                echo "❌ daemon 未连接（socket 不可用），无法执行 policy preset" >&2
                return 1
            fi
            printf '%s\n' "$resp"
            return 0
            ;;
        *)
            echo "用法: sunctl policy status|reload|preset list|preset apply <name>|preset clear" >&2
            return 2
            ;;
    esac
}

cmd_events() {
    # L3.1 结构化事件时间线（JSON 数组，最旧→最新；WebUI 日志页数据源升级的前置）
    #   events [行数=50] -> 最近 N 条（缺省 50；0 = 全部）
    lines="${1:-50}"
    case "$lines" in
        ''|*[!0-9]*) echo "用法: sunctl events [行数]" >&2; return 2 ;;
    esac
    resp="$(sock_query "events $lines")"
    if [ -z "$resp" ]; then
        echo "❌ daemon 未连接（socket 不可用），无法读取事件缓冲" >&2
        return 1
    fi
    printf '%s\n' "$resp"
    return 0
}

cmd_version() {
    echo "Sundown $VERSION (by SunsetREN)"
    echo "  daemon: $(daemon_version)"
}

usage() {
    cat >&2 <<EOF
用法: sunctl <命令> [参数]

  status [--json]        查看模块与守护进程状态
  env-check              环境自检（KSU / Zygisk 提供方 / 文件完整性）
  restart-daemon         重启 sundownd 守护进程
  restart-runtime --yes  软重启 Android 运行时（zygote，不丢数据）
  reload-probe           [L2] 热更新探针 dex
  policy status          [L3] 查询冻结策略状态（JSON）
  policy reload          [L3] 强制从磁盘重载策略
  policy preset list     [L3] 情景预设列表 + 当前生效
  policy preset apply <n> [L3] 应用预设（内存覆盖 [general]，不动磁盘 policy.toml）
  policy preset clear    [L3] 清除预设（回落磁盘 policy.toml 参数）
  events [行数]          [L3.1] 结构化事件时间线（JSON；焦点/唤醒/冻结/豁免/握手）
  apply-update [src]    [L0] 下载/暂存 daemon 更新（src=本地zip或URL；缺省查 GitHub Nightly）
  apply-update --activate [L0] 立即激活已暂存更新（备份/readiness/自动回滚）
  logs [行数]            查看启动看门狗日志
  logs --engine [行数]   查看引擎事件日志（焦点/唤醒/冻结时间轴）
  version                版本信息
EOF
    return 2
}

# ---------- 入口 ----------

case "$1" in
    status)          shift; cmd_status "$@" ;;
    env-check)       cmd_env_check ;;
    restart-daemon)  cmd_restart_daemon ;;
    restart-runtime) shift; cmd_restart_runtime "$@" ;;
    reload-probe)    cmd_reload_probe ;;
    policy)          shift; cmd_policy "$@" ;;
    events)          shift; cmd_events "$@" ;;
    apply-update)    shift; cmd_apply_update "$@" ;;
    logs)            shift; cmd_logs "$@" ;;
    version|--version|-v) cmd_version ;;
    *)               usage ;;
esac